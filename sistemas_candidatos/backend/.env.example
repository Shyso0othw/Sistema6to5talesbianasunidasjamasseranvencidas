# DEVELOPMENT ONLY. Copy to backend/.env and replace every CHANGE_* value.
DJANGO_ENV=development
DB_ENGINE=django.db.backends.postgresql
# Direct host db.<ref>.supabase.co is IPv6-only; use the IPv4 pooler of the project region.
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.CHANGE_PROJECT_REF
DB_PASSWORD=CHANGE_DB_PASSWORD
DB_SSLMODE=require
DJANGO_SECRET_KEY=CHANGE_LOCAL_RANDOM_SECRET

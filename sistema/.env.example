# Example only: copy outside the repository to /etc/sistema-escolar/app.env.
# Django does not load this file automatically; systemd EnvironmentFile supplies it.
DJANGO_ENV=staging
DJANGO_SECRET_KEY=CHANGE_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
ALLOWED_HOSTS=127.0.0.1,localhost,srv-app01
CSRF_TRUSTED_ORIGINS=http://srv-app01,http://127.0.0.1
DB_NAME=sistema_escolar_staging
DB_USER=sistema_app
DB_PASSWORD=CHANGE_DATABASE_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
# Optional browser push: configure both keys and a real contact subject together.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:CHANGE_CONTACT
PUSH_ALLOWED_HOSTS=
# Production additionally requires HTTPS origins/domain and SMTP configuration.
EMAIL_HOST=CHANGE_SMTP_HOST
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_SMTP_USER
EMAIL_HOST_PASSWORD=CHANGE_SMTP_PASSWORD
DEFAULT_FROM_EMAIL=CHANGE_SENDER
